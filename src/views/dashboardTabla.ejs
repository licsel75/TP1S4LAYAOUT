<%- include('partials/header') %>

<!-- Formulario de búsqueda -->
<div class="search-container">
    <form action="/dashboard" method="GET" class="search-form">
        <input type="text" 
               name="nombre" 
               value="<%= busqueda %>" 
               placeholder="Buscar por nombre..." 
               class="search-input">
        <button type="submit" class="btn search">🔍 Buscar</button>
        <a href="/dashboard" class="btn clear">✖️ Limpiar</a>
    </form>
</div>

<h1><%= titulo %></h1>

<% if (superheroes && superheroes.length > 0) { %>

    <!-- ========================================== -->
    <!-- TABLA DE SUPERHÉROES (en lugar de tarjetas) -->
    <!-- ========================================== -->
    <table class="heroes-table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Nombre Real</th>
                <th>Edad</th>
                <th>Planeta</th>
                <th>Debilidad</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            <% superheroes.forEach(heroe => { %>
                <tr>
                    <td><%= heroe.nombreSuperHeroe %></td>
                    <td><%= heroe.nombreReal %></td>
                    <td><%= heroe.edad %> años</td>
                    <td><%= heroe.planetaOrigen || 'Tierra' %></td>
                    <td><%= heroe.debilidad || 'Ninguna' %></td>
                    <td class="table-actions">
                        <a href="/dashboard/editar/<%= heroe._id %>" class="btn edit">✏️ Editar</a>
                        <button onclick="eliminar('<%= heroe._id %>', '<%= heroe.nombreSuperHeroe %>')" class="btn delete">🗑️ Eliminar</button>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>

<% } else { %>

    <div class="alert warning">
        ⚠️ No hay superhéroes cargados. ¡Agregá uno!
    </div>

<% } %>

<!-- AGREGAR -->
<a href="/dashboard/agregar" class="btn add">
    ➕ Agregar Nuevo Superhéroe
</a>

<script>
    function eliminar(id, nombre) {
        if (confirm(`¿Eliminar a ${nombre}?`)) {
            fetch(`/api/heroes/eliminar/${id}?_method=DELETE`, { method: 'POST' })
                .then(() => window.location.href = '/dashboard')
                .catch(err => console.error('Error:', err));
        }
    }
</script>

<%- include('partials/footer') %>